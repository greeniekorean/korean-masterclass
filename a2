                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .wrapper {
                width: 100% !important;
                max-width: none !important;
                padding: 0 !important;
                display: block !important;
            }
            .nav-bar, .creator-tag {
                display: none !important;
