            padding: 24px 30px !important;
            width: 100%;
            max-width: 680px;
            margin: 0 auto;
            text-align: left;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .pipeline-title {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 2px;
